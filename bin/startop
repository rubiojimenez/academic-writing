#!/usr/bin/env python3

# Author: Jesús Rubio
# Email: jesus@rubiojimenez.com
# Created: 2026-07

"""
Launch a predefined KDE Plasma workspace using Dolphin and VSCodium.

Usage:
    Run the script to open the configured Dolphin split-view windows and
    VSCodium instances.

Configuration:
    Adapt the paths in the workspace dictionary to match the local filesystem.

    Dolphin and VSCodium should be configured separately with the preferred
    window layout, terminal panels, views, and icon settings.
"""

from pathlib import Path
from shutil import which
from subprocess import DEVNULL, Popen
import sys
import time


home = Path.home()

workspace = {
    "workspace": home / "sync-works/research/workspace",
    "processing": home / "sync-life/miscellany/processing",
    "overleaf": home / "sync-works/research/overleaf",
    "qcs": home / "sync-works/research/qcs",
    "website": home / "sync-works/website",
}

dolphin_folders = [
    (
        workspace["workspace"],
        workspace["processing"],
    ),
    (
        workspace["overleaf"],
        workspace["qcs"],
    ),
]

codium_dirs = [
    workspace["website"],
]


def check_executable(command: str) -> None:
    if which(command) is None:
        raise RuntimeError(f"executable not found: {command}")


def check_directory(path: Path) -> None:
    if not path.is_dir():
        raise RuntimeError(f"directory not found: {path}")


def launch(command: list[str]) -> None:
    Popen(
        command,
        stdout=DEVNULL,
        stderr=DEVNULL,
        start_new_session=True,
    )


def main() -> int:
    try:
        check_executable("dolphin")
        check_executable("codium")

        for left, right in dolphin_folders:
            check_directory(left)
            check_directory(right)

        for directory in codium_dirs:
            check_directory(directory)

        for left, right in dolphin_folders:
            launch(
                [
                    "dolphin",
                    "--new-window",
                    "--split",
                    str(left),
                    str(right),
                ]
            )
            time.sleep(0.5)

        for directory in codium_dirs:
            launch(
                [
                    "codium",
                    "--new-window",
                    str(directory),
                ]
            )
            time.sleep(0.5)

    except RuntimeError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
