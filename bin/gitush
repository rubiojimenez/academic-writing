"""
Command-line utility to speed up routine Git commits.

Usage:
    Run the script, enter a commit message when prompted,
    and it will stage all changes, create a commit, and push it to the current branch.
"""

import subprocess
import sys


def run(command):
    if subprocess.run(command).returncode != 0:
        print("\nError: Git has failed. Please check the messages above.")
        sys.exit(1)


def main():
    commit_message = input("Commit message: ").strip()
    if not commit_message:
        print("Error: commit message cannot be empty.")
        sys.exit(1)

    run(["git", "add", "."])
    run(["git", "commit", "-m", commit_message])
    run(["git", "push"])

    print("Done.")


if __name__ == "__main__":
    main()
